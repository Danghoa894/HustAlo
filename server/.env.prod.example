# server/.env.prod.example — env production của server (development_guide.md §9.4). Copy thành server/.env.prod
# trên VM (chmod 600); workflow cicd-docker ghi file này từ secret PROD_SERVER_ENV. KHÔNG commit bản thật.
# Secret sinh riêng cho production bằng `npm run secrets` trên máy tin cậy — KHÁC giá trị dev.
# Không đặt SEED_PASSWORD, DEV_CALL_RING_TIMEOUT_MS, REDIS_URL_TEST ở production (env.ts từ chối / không dùng).

# ---------- Chung ----------
NODE_ENV=production
PORT=4000
# Một hop proxy: nginx biên
TRUST_PROXY=1
CORS_ORIGINS=https://hustalo.example.com
LOG_LEVEL=info
METRICS_PORT=9464

# ---------- MongoDB: user app (infra/mongo/init-prod.js), không dùng root ----------
MONGODB_URI=mongodb://hustalo:replace-with-mongo-app-password@mongo:27017/hustalo?replicaSet=rs0&authSource=hustalo

# ---------- Redis (mật khẩu = REDIS_PASSWORD của infra/.env.prod) ----------
REDIS_URL=redis://:replace-with-redis-password@redis:6379/0
REDIS_KEY_PREFIX=hustalo:

# ---------- Auth ----------
JWT_ACCESS_SECRET=replace-with-output-of-npm-run-secrets
JWT_ISSUER=hustalo-api
JWT_AUDIENCE=hustalo-web
REFRESH_TOKEN_PEPPER=replace-with-output-of-npm-run-secrets
# Bắt buộc true ở production (EC-SEC-009, T-22)
COOKIE_SECURE=true

# ---------- Mã hóa lưu trữ AES-256-GCM ----------
DATA_ENCRYPTION_KEYS={"replace-key-id":"replace-with-output-of-npm-run-secrets"}
DATA_ENCRYPTION_ACTIVE_KEY_ID=replace-key-id

# ---------- Socket.IO ----------
SOCKET_PATH=/socket.io
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=20000
SOCKET_ADAPTER=memory

# ---------- WebRTC / ICE: cần ít nhất một nguồn TURN (Xirsys hoặc coturn tự host) ----------
STUN_URLS=stun:stun.l.google.com:19302
XIRSYS_IDENT=replace-with-xirsys-ident
XIRSYS_SECRET=replace-with-xirsys-secret
XIRSYS_CHANNEL=hustalo
XIRSYS_API_URL=https://global.xirsys.net
# coturn production nếu tự host (mở 3478/5349 + dải relay UDP ở firewall, §9.1); để trống nếu chỉ dùng Xirsys
TURN_FALLBACK_URLS=
TURN_FALLBACK_USERNAME=
TURN_FALLBACK_CREDENTIAL=
ICE_TRANSPORT_POLICY=all
