{
  "name": "@hustalo/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsup",
    "start": "node --env-file=.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:indexes": "tsx --env-file=.env src/infra/db/indexes.ts",
    "db:seed": "tsx --env-file=.env src/infra/db/seed.ts",
    "db:migrate": "tsx --env-file=.env src/infra/db/migrate.ts",
    "job:reencrypt": "tsx --env-file=.env src/jobs/reencrypt-messages.ts",
    "user:lock": "tsx --env-file=.env src/jobs/user-lock.ts lock",
    "user:unlock": "tsx --env-file=.env src/jobs/user-lock.ts unlock"
  },
  "dependencies": {
    "@hustalo/shared": "*",
    "@socket.io/redis-streams-adapter": "0.3.1",
    "cors": "2.8.6",
    "express": "4.22.3",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "mongoose": "8.24.7",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "rate-limiter-flexible": "11.2.3",
    "socket.io": "4.8.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}
