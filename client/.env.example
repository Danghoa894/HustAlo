# client/.env.example — copy thành client/.env.
# CHỈ biến có tiền tố VITE_ được đưa vào bundle trình duyệt → TUYỆT ĐỐI không đặt secret ở đây.
# scripts/check-bundle-secrets.mjs làm build thất bại nếu có biến VITE_* mang tên nhạy cảm (AC-105).

# Base REST. Đường dẫn tương đối → đi qua proxy Vite (dev) hoặc reverse proxy (production), cùng origin.
VITE_API_URL=/api/v1
# URL Socket.IO. "/" = cùng origin với trang; path cố định /socket.io (kiến trúc §6.4).
VITE_SOCKET_URL=/
# 1 = Vite dev server chạy HTTPS bằng chứng chỉ infra/certs (cần npm run certs). Bỏ trống = http://localhost:5173 (DG-01).
# Chỉ vite.config.ts đọc biến này; không phải secret.
# VITE_HTTPS=1
# Playwright: URL đích của E2E (không phải biến VITE_, không vào bundle). Bỏ trống = http://localhost:5173.
# Đặt https://<domain> để chạy smoke @smoke trên môi trường đã deploy (development_guide.md §9.7).
# E2E_BASE_URL=https://hustalo.example.com
